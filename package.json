{
  "name": "@tselect/countries",
  "version": "1.0.0",
  "description": "Countries related data and enums.",
  "keywords": [
    "tselect",
    "country",
    "code",
    "data",
    "typescript",
    "enum"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "cov": "vitest run --coverage",
    "lint": "tslint --project ./",
    "fix": "tslint --fix --project ./",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm lint && pnpm cov && pnpm build",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tselect-npm/countries.git"
  },
  "author": "Sylvain Estevez",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "bugs": {
    "url": "https://github.com/tselect-npm/countries/issues"
  },
  "homepage": "https://github.com/tselect-npm/countries#readme",
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "tsdown": "^0.22.14",
    "tslint": "6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
